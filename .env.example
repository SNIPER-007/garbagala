# Firebase Client Config (Safe for browser)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=garbagala.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=garbagala
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=garbagala.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Razorpay Client Key (Safe for browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx

# Server Secrets (NEVER expose to browser)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

RESEND_API_KEY=re_123456789
EMAIL_FROM=Garba Gala Tickets <tickets@garbagala.com>

# Firebase Admin Service Account (JSON string or path)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@garbagala.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
