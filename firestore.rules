rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && (getUserData().role == 'super_admin');
    }

    function isOrganizerOrStaff() {
      return isSignedIn() && (
        getUserData().role == 'organizer' || 
        getUserData().role == 'checkin_staff' || 
        getUserData().role == 'super_admin'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isOwner(userId) || isOrganizerOrStaff();
      allow create: if isOwner(userId) && request.resource.data.role == 'customer';
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      allow delete: if isSuperAdmin();
    }

    // EVENTS COLLECTION
    match /events/{eventId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // TICKET TYPES COLLECTION
    match /ticketTypes/{ticketTypeId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // BOOKINGS COLLECTION
    match /bookings/{bookingId} {
      allow read: if isOrganizerOrStaff() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if true; // Create pending bookings allowed; status changes require server SDK
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // TICKETS COLLECTION
    match /tickets/{ticketId} {
      allow read: if isOrganizerOrStaff() || (isSignedIn() && resource.data.holderEmail == request.auth.token.email);
      allow create: if isSuperAdmin(); // Ticket issuance restricted to Server Functions / Admin SDK
      allow update: if isOrganizerOrStaff() 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ticketStatus', 'checkedInAt', 'checkedInBy', 'updatedAt'])
        && request.resource.data.ticketStatus == 'checked_in';
      allow delete: if isSuperAdmin();
    }

    // CHECK INS COLLECTION
    match /checkIns/{checkInId} {
      allow read: if isOrganizerOrStaff();
      allow create: if isOrganizerOrStaff();
      allow write: if isSuperAdmin();
    }

    // AUDIT LOGS COLLECTION
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // COUNTERS COLLECTION
    match /counters/{counterId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }
  }
}
